@page "/"
@inject HospitalTriageAI.Services.IPatientService PatientService

<div class="home-page">
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1>Making Health<br />Care Better<br /><span class="text-primary">Together</span></h1>
            <p class="hero-desc">
                Duis aute irure dolor in reprehenderit in voluptate velit esse cillum 
                dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat 
                non proident, sunt in culpa qui officia deserunt.
            </p>
            <div class="hero-cta">
                <div class="email-input-group">
                    <div class="email-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <input type="email" placeholder="Your email address" class="email-input" />
                    <a href="/intake" class="btn btn-accent">Make an Appointment</a>
                </div>
            </div>
        </div>
        <div class="hero-cards">
            <div class="floating-card card-recording">
                <div class="card-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="23 7 16 12 23 17 23 7"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                    </svg>
                </div>
                <span>Recording Videos</span>
            </div>
            <div class="floating-card card-question">
                <div class="card-header-custom">Quick question!</div>
                <p>What should we take<br />and what we have<br />to avoid.</p>
            </div>
            <div class="floating-card card-profile">
                <div class="card-header-custom">Profile</div>
                <div class="profile-lines">
                    <div class="line"></div>
                    <div class="line short"></div>
                </div>
            </div>
            <div class="floating-card card-patients">
                <span class="patients-label">Smile Patients</span>
                <div class="avatar-row">
                    <div class="avatar">
                        <img src="https://i.pravatar.cc/100?img=1" alt="Patient" />
                    </div>
                    <div class="avatar">
                        <img src="https://i.pravatar.cc/100?img=2" alt="Patient" />
                    </div>
                    <div class="avatar">
                        <img src="https://i.pravatar.cc/100?img=3" alt="Patient" />
                    </div>
                    <div class="avatar">
                        <img src="https://i.pravatar.cc/100?img=4" alt="Patient" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Section -->
    <section class="why-section">
        <h2>Why Union Hospital?</h2>
        <div class="features-grid">
            <div class="feature-box">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <h3>All Specialists</h3>
                <p>Access to comprehensive medical specialists for all your healthcare needs.</p>
            </div>
            <div class="feature-box">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
                    </svg>
                </div>
                <h3>All Services</h3>
                <p>Complete healthcare services from diagnosis to treatment and follow-up care.</p>
            </div>
            <div class="feature-box">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12,6 12,12 16,14"/>
                    </svg>
                </div>
                <h3>24/7 Available</h3>
                <p>Round-the-clock emergency services and patient support whenever you need.</p>
            </div>
            <div class="feature-box">
                <div class="feature-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                </div>
                <h3>Secure & Private</h3>
                <p>Your health data is protected with enterprise-grade security measures.</p>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="stat-card">
            <span class="stat-value">95%</span>
            <span class="stat-label">Patient Satisfaction</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">&lt;5min</span>
            <span class="stat-label">Average Wait Time</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">@_totalPatients+</span>
            <span class="stat-label">Patients Served</span>
        </div>
        <div class="stat-card">
            <span class="stat-value">24/7</span>
            <span class="stat-label">Available</span>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <h2>Ready to Get Started?</h2>
        <p>Begin your healthcare journey with us today.</p>
        <a href="/intake" class="btn btn-white">Register Patient</a>
    </section>
</div>

@code {
    private int _totalPatients = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var patients = await PatientService.GetAllPatientsAsync();
            _totalPatients = patients.Count();
        }
        catch { _totalPatients = 0; }
    }
}

<style>
    .home-page {
        display: flex;
        flex-direction: column;
        gap: var(--space-12);
    }

    /* Hero */
    .hero {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-8);
        align-items: center;
        padding: var(--space-8) 0;
    }

    .hero h1 {
        font-size: 3rem;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: var(--space-6);
        color: var(--gray-900);
    }

    .hero-desc {
        font-size: 1rem;
        color: var(--gray-500);
        margin-bottom: var(--space-8);
        line-height: 1.7;
    }

    .email-input-group {
        display: flex;
        align-items: center;
        gap: 0;
        max-width: 500px;
        background: var(--white);
        border: 2px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: var(--space-2);
        padding-left: var(--space-4);
    }

    .email-icon {
        color: var(--gray-400);
        display: flex;
        align-items: center;
        margin-right: var(--space-2);
    }

    .email-input {
        flex: 1;
        padding: var(--space-2);
        border: none;
        font-size: 0.9375rem;
        background: transparent;
        font-family: 'Poppins', sans-serif;
    }

    .email-input:focus {
        outline: none;
    }

    .email-input::placeholder {
        color: var(--gray-400);
    }

    /* Floating Cards - Union Hospital Style */
    .hero-cards {
        position: relative;
        height: 400px;
    }

    .floating-card {
        position: absolute;
        background: var(--white);
        border: 2px solid var(--primary-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-card);
    }

    .card-header-custom {
        background: var(--accent);
        color: var(--white);
        padding: var(--space-2) var(--space-4);
        font-weight: 600;
        font-size: 0.875rem;
    }

    .card-recording {
        top: 80px;
        left: 30px;
        padding: var(--space-3) var(--space-4);
        display: flex;
        align-items: center;
        gap: var(--space-3);
        background: var(--accent);
        color: var(--white);
        border-color: var(--accent);
    }

    .card-recording .card-icon {
        display: flex;
    }

    .card-question {
        top: 20px;
        right: 20px;
        width: 220px;
    }

    .card-question p {
        padding: var(--space-4);
        margin: 0;
        font-size: 0.875rem;
        color: var(--gray-700);
        line-height: 1.5;
    }

    .card-profile {
        top: 180px;
        left: 60px;
        width: 180px;
    }

    .profile-lines {
        padding: var(--space-4);
    }

    .profile-lines .line {
        height: 10px;
        background: var(--primary-light);
        border-radius: 5px;
        margin-bottom: var(--space-2);
    }

    .profile-lines .line.short {
        width: 60%;
    }

    .card-patients {
        bottom: 30px;
        right: 40px;
        padding: var(--space-4);
        background: var(--accent);
        border-color: var(--accent);
    }

    .patients-label {
        display: block;
        color: var(--white);
        font-size: 0.75rem;
        font-weight: 500;
        margin-bottom: var(--space-3);
    }

    .avatar-row {
        display: flex;
        gap: -8px;
    }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        overflow: hidden;
        border: 2px solid var(--white);
        margin-left: -8px;
    }

    .avatar:first-child {
        margin-left: 0;
    }

    .avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Why Section - Union Hospital Style */
    .why-section {
        background: var(--primary);
        color: var(--white);
        padding: var(--space-12) var(--space-8);
        border-radius: var(--radius-xl);
        margin: 0 calc(var(--space-6) * -1);
    }

    .why-section h2 {
        color: var(--white);
        text-align: center;
        margin-bottom: var(--space-8);
        font-size: 2rem;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
    }

    .feature-box {
        background: rgba(255,255,255,0.15);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        transition: background 0.2s ease;
    }

    .feature-box:hover {
        background: rgba(255,255,255,0.2);
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        background: var(--white);
        color: var(--primary);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: var(--space-4);
    }

    .feature-box h3 {
        color: var(--white);
        font-size: 1.125rem;
        margin-bottom: var(--space-2);
    }

    .feature-box p {
        color: rgba(255,255,255,0.85);
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0;
    }

    /* Stats */
    .stats-section {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
    }

    .stat-card {
        background: var(--white);
        border: 2px solid var(--primary-border);
        border-radius: var(--radius-lg);
        padding: var(--space-6);
        text-align: center;
        box-shadow: var(--shadow-card);
        transition: transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-value {
        display: block;
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--primary);
    }

    .stat-label {
        color: var(--gray-500);
        font-size: 0.875rem;
    }

    /* CTA */
    .cta-section {
        background: var(--accent);
        color: var(--white);
        padding: var(--space-12);
        border-radius: var(--radius-xl);
        text-align: center;
        margin: 0 calc(var(--space-6) * -1);
    }

    .cta-section h2 {
        color: var(--white);
        margin-bottom: var(--space-2);
    }

    .cta-section p {
        color: rgba(255,255,255,0.9);
        margin-bottom: var(--space-6);
    }

    @@media (max-width: 1024px) {
        .hero { grid-template-columns: 1fr; }
        .hero-cards { display: none; }
        .features-grid { grid-template-columns: repeat(2, 1fr); }
        .stats-section { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 640px) {
        .hero h1 { font-size: 2rem; }
        .email-input-group { flex-direction: column; border-radius: var(--radius-lg); }
        .email-input-group .btn { width: 100%; margin-top: var(--space-2); }
        .features-grid { grid-template-columns: 1fr; }
        .stats-section { grid-template-columns: 1fr; }
    }
</style>
