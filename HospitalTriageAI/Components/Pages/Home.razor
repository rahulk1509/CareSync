@page "/"
@using HospitalTriageAI.Models.Enums
@inject HospitalTriageAI.Services.IPatientService PatientService
@inject HospitalTriageAI.Services.ITriageService TriageService
@inject NavigationManager Navigation

<div class="queue-page">
    <div class="page-header">
        <div class="header-content">
            <h1>Patient Priority Queue</h1>
            <p>Real-time triage queue sorted by severity</p>
        </div>
        <a href="/intake" class="btn btn-accent">+ New Patient</a>
    </div>

    @if (_loading)
    {
        <div class="loading-container">
            <div class="spinner-lg"></div>
            <p>Loading patient queue...</p>
        </div>
    }
    else if (!_patients.Any())
    {
        <div class="empty-state card">
            <div class="empty-icon">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <h3>No Patients in Queue</h3>
            <p>Register a new patient to begin triage assessment</p>
            <a href="/intake" class="btn btn-primary">Register New Patient</a>
        </div>
    }
    else
    {
        <!-- Queue Statistics -->
        <div class="queue-stats">
            <div class="stat-card stat-emergency">
                <span class="stat-count">@_patients.Count(p => p.CurrentTriageLevel == TriageLevel.Emergency)</span>
                <span class="stat-label">Emergency</span>
            </div>
            <div class="stat-card stat-urgent">
                <span class="stat-count">@_patients.Count(p => p.CurrentTriageLevel == TriageLevel.Urgent)</span>
                <span class="stat-label">Urgent</span>
            </div>
            <div class="stat-card stat-standard">
                <span class="stat-count">@_patients.Count(p => p.CurrentTriageLevel == TriageLevel.Standard)</span>
                <span class="stat-label">Standard</span>
            </div>
            <div class="stat-card stat-nonurgent">
                <span class="stat-count">@_patients.Count(p => p.CurrentTriageLevel == TriageLevel.NonUrgent)</span>
                <span class="stat-label">Non-Urgent</span>
            </div>
            <div class="stat-card stat-total">
                <span class="stat-count">@_patients.Count</span>
                <span class="stat-label">Total</span>
            </div>
        </div>

        <!-- Patient Queue List -->
        <div class="queue-container">
            @foreach (var patient in _patients)
            {
                <div class="patient-card @GetTriageClass(patient.CurrentTriageLevel)">
                    <div class="priority-indicator">
                        <span class="priority-number">@GetQueuePosition(patient)</span>
                    </div>
                    <div class="patient-main">
                        <div class="patient-avatar">@patient.FirstName[0]@patient.LastName[0]</div>
                        <div class="patient-details">
                            <h3>@patient.FullName</h3>
                            <p class="complaint">@(patient.ChiefComplaint ?? "No complaint recorded")</p>
                            <div class="patient-meta">
                                <span class="meta-item">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/>
                                        <polyline points="12,6 12,12 16,14"/>
                                    </svg>
                                    @GetWaitTime(patient)
                                </span>
                                <span class="meta-item">@patient.Age yrs, @patient.Gender</span>
                            </div>
                        </div>
                    </div>
                    <div class="patient-status">
                        <div class="triage-badge @GetTriageBadgeClass(patient.CurrentTriageLevel)">
                            @GetTriageText(patient.CurrentTriageLevel)
                        </div>
                        <div class="department-badge">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 21h18"/>
                                <path d="M9 8h1"/>
                                <path d="M9 12h1"/>
                                <path d="M9 16h1"/>
                                <path d="M14 8h1"/>
                                <path d="M14 12h1"/>
                                <path d="M14 16h1"/>
                                <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/>
                            </svg>
                            @GetDepartmentText(patient.AssignedDepartment)
                        </div>
                    </div>
                    <div class="patient-actions">
                        <button class="btn btn-outline btn-sm" @onclick="() => ViewEMR(patient.Id)">
                            EMR
                        </button>
                        <button class="btn btn-primary btn-sm" @onclick="() => StartTriage(patient.Id)">
                            Triage
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Patient> _patients = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        _loading = true;
        try
        {
            var allPatients = await PatientService.GetAllPatientsAsync();
            // Sort by triage level (Emergency first) then by creation time
            _patients = allPatients
                .OrderBy(p => p.CurrentTriageLevel == TriageLevel.Unassessed ? 99 : (int)p.CurrentTriageLevel)
                .ThenBy(p => p.CreatedAt)
                .ToList();
        }
        catch
        {
            _patients = new List<Patient>();
        }
        _loading = false;
    }

    private int GetQueuePosition(Patient patient)
    {
        return _patients.IndexOf(patient) + 1;
    }

    private string GetWaitTime(Patient patient)
    {
        var elapsed = DateTime.Now - patient.CreatedAt;
        if (elapsed.TotalMinutes < 1) return "Just now";
        if (elapsed.TotalMinutes < 60) return $"{(int)elapsed.TotalMinutes} min";
        if (elapsed.TotalHours < 24) return $"{(int)elapsed.TotalHours}h {elapsed.Minutes}m";
        return $"{(int)elapsed.TotalDays}d ago";
    }

    private string GetTriageClass(TriageLevel level) => level switch
    {
        TriageLevel.Emergency => "triage-emergency",
        TriageLevel.Urgent => "triage-urgent",
        TriageLevel.Standard => "triage-standard",
        TriageLevel.NonUrgent => "triage-nonurgent",
        _ => "triage-unassessed"
    };

    private string GetTriageBadgeClass(TriageLevel level) => level switch
    {
        TriageLevel.Emergency => "badge-emergency",
        TriageLevel.Urgent => "badge-urgent",
        TriageLevel.Standard => "badge-standard",
        TriageLevel.NonUrgent => "badge-nonurgent",
        _ => "badge-unassessed"
    };

    private string GetTriageText(TriageLevel level) => level switch
    {
        TriageLevel.Emergency => "EMERGENCY",
        TriageLevel.Urgent => "URGENT",
        TriageLevel.Standard => "STANDARD",
        TriageLevel.NonUrgent => "NON-URGENT",
        _ => "PENDING"
    };

    private string GetDepartmentText(Department dept) => dept switch
    {
        Department.Cardiology => "Cardiology",
        Department.Pulmonology => "Pulmonology",
        Department.Neurology => "Neurology",
        Department.Surgery => "Surgery",
        Department.Orthopedics => "Orthopedics",
        Department.GeneralMedicine => "General Medicine",
        Department.InfectiousDisease => "Infectious Disease",
        Department.EmergencyTrauma => "Emergency/Trauma",
        Department.PainManagement => "Pain Management",
        _ => "Not Assigned"
    };

    private void ViewEMR(int id)
    {
        Navigation.NavigateTo($"/emr/{id}");
    }

    private void StartTriage(int id)
    {
        Navigation.NavigateTo($"/triage/{id}");
    }
}

<style>
    .queue-page {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        padding-bottom: var(--space-8);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--space-4) 0;
        border-bottom: 2px solid var(--primary-border);
    }

    .page-header h1 {
        margin: 0;
        font-size: 1.75rem;
    }

    .page-header p {
        margin: var(--space-1) 0 0;
        color: var(--gray-500);
        font-size: 0.9375rem;
    }

    /* Loading & Empty States */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-16);
        color: var(--gray-500);
    }

    .spinner-lg {
        width: 40px;
        height: 40px;
        border: 3px solid var(--gray-200);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-bottom: var(--space-4);
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .empty-state {
        text-align: center;
        padding: var(--space-12);
    }

    .empty-icon {
        color: var(--gray-300);
        margin-bottom: var(--space-4);
    }

    .empty-state h3 {
        margin-bottom: var(--space-2);
    }

    .empty-state p {
        color: var(--gray-500);
        margin-bottom: var(--space-6);
    }

    /* Queue Statistics */
    .queue-stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: var(--space-4);
    }

    .stat-card {
        background: var(--white);
        border: 2px solid var(--gray-200);
        border-radius: var(--radius-md);
        padding: var(--space-4);
        text-align: center;
        transition: transform 0.2s;
    }

    .stat-card:hover {
        transform: translateY(-2px);
    }

    .stat-count {
        display: block;
        font-size: 2rem;
        font-weight: 700;
    }

    .stat-label {
        font-size: 0.8125rem;
        color: var(--gray-500);
    }

    .stat-emergency { border-color: #dc2626; }
    .stat-emergency .stat-count { color: #dc2626; }

    .stat-urgent { border-color: #f59e0b; }
    .stat-urgent .stat-count { color: #f59e0b; }

    .stat-standard { border-color: #3b82f6; }
    .stat-standard .stat-count { color: #3b82f6; }

    .stat-nonurgent { border-color: #22c55e; }
    .stat-nonurgent .stat-count { color: #22c55e; }

    .stat-total { border-color: var(--primary); }
    .stat-total .stat-count { color: var(--primary); }

    /* Patient Queue */
    .queue-container {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .patient-card {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        background: var(--white);
        border: 2px solid var(--gray-200);
        border-radius: var(--radius-lg);
        padding: var(--space-4);
        transition: all 0.2s;
    }

    .patient-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateX(4px);
    }

    /* Triage Level Borders */
    .triage-emergency { border-left: 5px solid #dc2626; }
    .triage-urgent { border-left: 5px solid #f59e0b; }
    .triage-standard { border-left: 5px solid #3b82f6; }
    .triage-nonurgent { border-left: 5px solid #22c55e; }
    .triage-unassessed { border-left: 5px solid var(--gray-300); }

    /* Priority Indicator */
    .priority-indicator {
        min-width: 40px;
        height: 40px;
        background: var(--gray-100);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .priority-number {
        font-weight: 700;
        font-size: 1rem;
        color: var(--gray-600);
    }

    .triage-emergency .priority-indicator { background: #fef2f2; }
    .triage-emergency .priority-number { color: #dc2626; }

    .triage-urgent .priority-indicator { background: #fffbeb; }
    .triage-urgent .priority-number { color: #f59e0b; }

    /* Patient Main Info */
    .patient-main {
        flex: 1;
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .patient-avatar {
        width: 48px;
        height: 48px;
        background: var(--primary);
        color: var(--white);
        border-radius: var(--radius-full);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 0.9375rem;
    }

    .patient-details h3 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .complaint {
        margin: var(--space-1) 0;
        font-size: 0.875rem;
        color: var(--gray-600);
        max-width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .patient-meta {
        display: flex;
        gap: var(--space-4);
        font-size: 0.8125rem;
        color: var(--gray-500);
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: var(--space-1);
    }

    /* Patient Status */
    .patient-status {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: var(--space-2);
        min-width: 150px;
    }

    .triage-badge {
        padding: var(--space-1) var(--space-3);
        border-radius: var(--radius-full);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    .badge-emergency { background: #fef2f2; color: #dc2626; }
    .badge-urgent { background: #fffbeb; color: #d97706; }
    .badge-standard { background: #eff6ff; color: #2563eb; }
    .badge-nonurgent { background: #f0fdf4; color: #16a34a; }
    .badge-unassessed { background: var(--gray-100); color: var(--gray-500); }

    .department-badge {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: 0.8125rem;
        color: var(--gray-600);
        padding: var(--space-1) var(--space-2);
        background: var(--gray-50);
        border-radius: var(--radius-sm);
    }

    /* Patient Actions */
    .patient-actions {
        display: flex;
        gap: var(--space-2);
    }

    .btn-sm {
        padding: var(--space-2) var(--space-4);
        font-size: 0.8125rem;
    }

    /* Responsive */
    @@media (max-width: 1024px) {
        .queue-stats {
            grid-template-columns: repeat(3, 1fr);
        }
        
        .patient-card {
            flex-wrap: wrap;
        }

        .patient-status {
            flex-direction: row;
            min-width: auto;
        }
    }

    @@media (max-width: 640px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: var(--space-4);
        }

        .queue-stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .patient-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .patient-main {
            width: 100%;
        }

        .patient-status {
            width: 100%;
            flex-direction: row;
            justify-content: space-between;
        }

        .patient-actions {
            width: 100%;
        }

        .patient-actions .btn {
            flex: 1;
        }
    }
</style>
